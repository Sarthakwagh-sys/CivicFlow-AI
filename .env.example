# CivicFlow AI Environment Configuration
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY / GOOGLE_MAPS_PLATFORM_KEY: For live map rendering and routes
GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_PLATFORM_KEY=""

# Application options
ENVIRONMENT="development"
USE_SIMULATED_TRAFFIC="true"
MCP_SERVER_URL="http://localhost:3000/mcp"
